class RoundRobin {

    private String[] servers;
    private int currentIndex = -1;

    public RoundRobin(String[] servers) {
        this.servers = servers;
    }

    public String getNextServer() {

        currentIndex =
            (currentIndex + 1) % servers.length;

        return servers[currentIndex];
    }
}

public class Main {

    public static void main(String[] args) {

        String[] servers = {
            "Server1",
            "Server2",
            "Server3"
        };

        RoundRobin loadBalancer =
            new RoundRobin(servers);

        for (int i = 0; i < 6; i++) {

            String server =
                loadBalancer.getNextServer();

            System.out.println(
                "Request " + (i + 1) + " -> " + server
            );
        }
    }
}
